{
    "name":  "veriflow-ai",
    "version":  "0.1.0",
    "private":  true,
    "workspaces":  [
                       "frontend",
                       "backend"
                   ],
    "engines":  {
                    "node":  "\u003e=22.12"
                },
    "scripts":  {
                    "dev":  "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
                    "build":  "npm run build --workspaces",
                    "test":  "npm run test --workspaces",
                    "lint":  "eslint .",
                    "typecheck":  "npm run typecheck --workspaces \u0026\u0026 tsc -p tsconfig.tools.json",
                    "start":  "npm run start -w backend",
                    "test:e2e":  "playwright test",
                    "db:generate":  "npm run db:generate -w backend",
                    "db:migrate":  "npm run db:migrate -w backend",
                    "db:seed":  "npm run db:seed -w backend",
                    "db:verify":  "npm exec -w backend -- tsx scripts/verify-demo.ts",
                    "verify:built":  "npm exec -w backend -- tsx scripts/smoke-built.ts"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.0",
                            "@playwright/test":  "^1.64.1",
                            "concurrently":  "^9.2.0",
                            "eslint":  "^9.39.0",
                            "globals":  "^16.5.0",
                            "typescript":  "~5.9.3",
                            "typescript-eslint":  "8.70.0"
                        },
    "allowScripts":  {
                         "esbuild@0.28.2":  true,
                         "bcrypt@6.0.0":  true,
                         "better-sqlite3@12.11.1":  true,
                         "@prisma/engines@7.10.1":  true,
                         "prisma@7.10.1":  true
                     }
}
